generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["luggagex"]
}

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @unique
  name          String
  passwordHash  String
  phone         String?
  avatarUrl     String?
  bio           String?   @db.Text
  verified      Boolean   @default(false)
  verifiedAt    DateTime?
  rating        Float     @default(0)
  totalDeals    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Stripe
  stripeCustomerId String? @unique

  // Referral
  referralCode     String?  @unique
  referredByUserId String?  @db.Uuid
  referredBy       User?    @relation("Referrals", fields: [referredByUserId], references: [id])
  referrals        User[]   @relation("Referrals")

  luggageOffers    LuggageOffer[]
  luggageRequests  LuggageRequest[]
  sentMessages     Message[]        @relation("SentMessages")
  receivedMessages Message[]        @relation("ReceivedMessages")
  reviewsGiven     Review[]         @relation("ReviewsGiven")
  reviewsReceived  Review[]         @relation("ReviewsReceived")
  transactions     Transaction[]    @relation("TransactionUser")
  bookmarks        Bookmark[]
  routeAlerts      RouteAlert[]

  @@schema("luggagex")
}

model LuggageOffer {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id])

  // Flight info
  flightNumber    String
  airline         String
  departureAirport String
  arrivalAirport  String
  departureCity   String
  arrivalCity     String
  departureDate   DateTime
  arrivalDate     DateTime

  // Luggage details
  availableWeight Float
  maxSingleItem   Float?
  sizeCategory    String   @default("M")
  description     String?  @db.Text

  // Pricing
  pricePerKg      Float?
  flatPrice       Float?
  currency        String   @default("EUR")
  negotiable      Boolean  @default(true)

  // Handover
  pickupType      String   @default("airport")
  pickupAddress   String?
  pickupLat       Float?
  pickupLng       Float?
  pickupTimeStart DateTime?
  pickupTimeEnd   DateTime?

  dropoffType     String   @default("airport")
  dropoffAddress  String?
  dropoffLat      Float?
  dropoffLng      Float?
  dropoffTimeStart DateTime?
  dropoffTimeEnd  DateTime?

  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  matches         Match[]
  bookmarks       Bookmark[]

  @@schema("luggagex")
}

model LuggageRequest {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id])

  // Route
  departureCity   String
  arrivalCity     String
  departureAirport String?
  arrivalAirport  String?

  // Date flexibility
  earliestDate    DateTime
  latestDate      DateTime

  // Luggage needs
  neededWeight    Float
  sizeCategory    String   @default("M")
  itemDescription String   @db.Text
  itemCategory    String   @default("general")

  // Budget
  maxBudget       Float?
  currency        String   @default("EUR")

  // Request type
  requestType     String   @default("shipment")
  flightNumber    String?

  // Handover preference
  pickupPreference  String @default("flexible")
  dropoffPreference String @default("flexible")

  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  matches         Match[]

  @@schema("luggagex")
}

model Match {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  offerId         String   @db.Uuid
  offer           LuggageOffer   @relation(fields: [offerId], references: [id])
  requestId       String   @db.Uuid
  request         LuggageRequest @relation(fields: [requestId], references: [id])

  score           Float    @default(0)
  agreedPrice     Float?
  currency        String   @default("EUR")

  status          String   @default("proposed")

  // Handover details
  handoverCode    String?  @unique
  pickupConfirmed   Boolean @default(false)
  pickupConfirmedAt DateTime?
  dropoffConfirmed  Boolean @default(false)
  dropoffConfirmedAt DateTime?
  pickupPhotoUrl    String?
  dropoffPhotoUrl   String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  messages        Message[]
  transaction     Transaction?
  reviews         Review[]

  @@schema("luggagex")
}

model Message {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId     String   @db.Uuid
  match       Match    @relation(fields: [matchId], references: [id])
  senderId    String   @db.Uuid
  sender      User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId  String   @db.Uuid
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  content     String   @db.Text
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@schema("luggagex")
}

model Transaction {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId         String   @unique @db.Uuid
  match           Match    @relation(fields: [matchId], references: [id])
  userId          String   @db.Uuid
  user            User     @relation("TransactionUser", fields: [userId], references: [id])
  amount          Float
  currency        String   @default("EUR")
  status          String   @default("pending")

  // Stripe
  stripePaymentIntentId String? @unique
  stripeTransferId      String?

  paidAt          DateTime?
  releasedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@schema("luggagex")
}

model Bookmark {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id])
  offerId     String   @db.Uuid
  offer       LuggageOffer @relation(fields: [offerId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([userId, offerId])
  @@schema("luggagex")
}

model Review {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId     String   @db.Uuid
  match       Match    @relation(fields: [matchId], references: [id])
  fromUserId  String   @db.Uuid
  fromUser    User     @relation("ReviewsGiven", fields: [fromUserId], references: [id])
  toUserId    String   @db.Uuid
  toUser      User     @relation("ReviewsReceived", fields: [toUserId], references: [id])
  rating      Int
  comment     String?  @db.Text
  response    String?  @db.Text
  respondedAt DateTime?
  createdAt   DateTime @default(now())

  @@schema("luggagex")
}

model RouteAlert {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id])
  departureCity   String
  arrivalCity     String
  departureAirport String?
  arrivalAirport  String?
  earliestDate    DateTime?
  latestDate      DateTime?
  maxPrice        Float?
  minWeight       Float?
  active          Boolean  @default(true)
  lastNotified    DateTime?
  createdAt       DateTime @default(now())

  @@schema("luggagex")
}

model ContactMessage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  email       String
  subject     String
  message     String   @db.Text
  category    String   @default("general")
  status      String   @default("open")
  userId      String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@schema("luggagex")
}
